# influxdb.env — InfluxDB server configuration
# Copy this to influxdb.env and fill in your values.

INFLUXDB_DB=powerwall
INFLUXDB_HTTP_AUTH_ENABLED=false
# Uncomment and set these if you enable HTTP auth:
# INFLUXDB_ADMIN_USER=admin
# INFLUXDB_ADMIN_PASSWORD=changeme
# INFLUXDB_USER=powerwall
# INFLUXDB_USER_PASSWORD=changeme
