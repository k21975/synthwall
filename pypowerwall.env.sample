# pypowerwall.env.sample — per-gateway template (local wired TEDAPI mode)
# setup.sh copies this to pypowerwall-a.env / -b.env / -c.env (one per gateway)
# and fills in the values. Do NOT commit the real files to version control.
#
# This stack uses pypowerwall's TEDAPI mode over wired ethernet.
# No Tesla account, Tesla developer app, or OAuth is required.
# The gateway must have a reserved LAN IP and be reachable from the Docker host.

# ── Required: gateway LAN IP ──────────────────────────────────────────────────
# Reserved LAN IP of this gateway (wired ethernet port).
# Verify reachability before setup: curl -k --head https://<IP>
PW_HOST=REPLACE_GATEWAY_IP

# ── Required: gateway hardware password ───────────────────────────────────────
# The gateway password is printed on the sticker on the Powerwall unit.
# It is also visible in the Tesla app under Gateway > Settings > Advanced.
PW_GW_PWD=REPLACE_GATEWAY_PASSWORD

# ── Timezone (match compose.env TZ) ──────────────────────────────────────────
PW_TIMEZONE=America/Los_Angeles

# ── Not required for local TEDAPI ────────────────────────────────────────────
# PW_EMAIL and PW_PASSWORD are not used in TEDAPI mode. Leave blank.
PW_EMAIL=
PW_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
# RSA key for Powerwall 3 v1r wired-LAN auth — generate/register once with
# `pypowerwall setup -v1r` (writes tedapi_rsa_private.pem into the auth dir, which
# powerwall.yml mounts to /app/.auth). Use the IN-CONTAINER path + the real filename.
# A wrong value here breaks TEDAPI and silently falls back to cloud ("Failed to
# connect to Powerwall with all modes") — that is NOT a lockout.
PW_RSA_KEY_PATH=/app/.auth/tedapi_rsa_private.pem

# Set to yes to enable verbose pypowerwall logging (useful during initial setup)
PW_DEBUG=no

# Set negative solar readings to zero (recommended)
PW_NEG_SOLAR=yes

# Label shown in logs and error messages (setup.sh sets Panel_A / _B / _C)
PW_LABEL=REPLACE_LABEL
