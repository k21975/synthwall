# compose.env — shared environment variables for all services
# Copy this to compose.env and fill in your values.
# Do NOT commit compose.env to version control.

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=America/Los_Angeles

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_PORT=8086
INFLUXDB_DB=powerwall
INFLUXDB_HOST=influxdb

# Bind-mount paths for persistent data (Unraid: /mnt/user/appdata/powerwall-dashboard/data/)
INFLUXDB_DATA_PATH=./data/influxdb
GRAFANA_DATA_PATH=./data/grafana

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PORT=9000

# ── Custom Web Dashboard (synthwave UI) ───────────────────────────────────────
WEBAPP_PORT=8050
# Optional: address(es) of a separate dashboard page allowed to read the webapp
# API from the browser, comma-separated, no trailing slash. Blank = none.
# Also adds a HOME button beside the settings gear, linking to the first one.
# e.g. DASHBOARD_ORIGINS=https://home.example.com
DASHBOARD_ORIGINS=

# ── Gateways ──────────────────────────────────────────────────────────────────
# System tags for your gateways, comma-separated in order: panel_a[,panel_b[,panel_c]]
# Written by setup.sh to match the generated powerwall.yml / telegraf.conf.
# The webapp settings page maps display names onto these tags.
GATEWAY_TAGS=panel_a,panel_b

# Host ports for the pypowerwall proxies (one per gateway)
PW_A_PORT=8675
PW_B_PORT=8676
PW_C_PORT=8677

# Gateway IPs and passwords live in pypowerwall-a.env / -b.env / -c.env
# (one file per gateway, written by setup.sh) — not here.

# Container user (should match Unraid Docker user, typically 99:100)
PW_USER=1000
PW_GROUP=1000

# ── Webapp branding defaults (overridable live on the settings page) ──────────
SITE_NAME=POWERWALL

# ── Enricher — derived metrics ────────────────────────────────────────────────
# Electricity rate for cost estimates ($/kWh); also editable live on the
# settings page (the settings file overrides these env defaults).
RATE_IMPORT=0.25
RATE_EXPORT=0.08

# Powerwall usable capacity behind each gateway (kWh) — for weighted SOC.
# Multiple Powerwalls on one gateway: enter their combined capacity.
PW_A_CAPACITY_KWH=13.5
PW_B_CAPACITY_KWH=13.5
PW_C_CAPACITY_KWH=13.5

# Polling interval for enricher (seconds)
ENRICHER_INTERVAL=60

# ── Weather (optional, enable with: docker compose --profile weather up -d) ───
WEATHER_PORT=8680
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
